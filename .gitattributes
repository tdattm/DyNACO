# Research scripts remain executable by WSL after a Windows Git checkout.
r3/** text eol=lf
tests/test_r3_*.py text eol=lf
# Preserve immutable measurement and provenance bytes, including saved SHA256s.
artifacts/r3/** -text
r3_final/** text eol=lf
tests/test_r3_final.py text eol=lf
artifacts/r3_final_end_to_end/** -text
# Evidence keeps standard CSV/log CRLF and intentional Markdown hard breaks.
artifacts/r3_final_end_to_end/** whitespace=cr-at-eol
artifacts/r3_final_end_to_end/**/*.md whitespace=-blank-at-eol,cr-at-eol
# Matplotlib SVG path serialization also contains intentional trailing spaces.
artifacts/r3_final_end_to_end/**/*.svg whitespace=-blank-at-eol,cr-at-eol
# Keep the exact compiled LF source bytes across Windows/WSL checkouts.
src/mfaco_train.cpp text eol=lf
src/mfaco_train.h text eol=lf
src/binding.cpp text eol=lf
